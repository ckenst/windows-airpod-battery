<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="AirPods Battery Tray"
      Manufacturer="AirPods Battery Tray"
      Version="1.2.1.0"
      UpgradeCode="6C9A2B67-0D6E-4A8B-8A7F-5BDF9D8C0A42"
      Scope="perUser"
      Compressed="yes">
    <SummaryInformation Description="AirPods battery monitor for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of AirPods Battery Tray is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="TrayIcon" SourceFile="$(var.SourceDir)\airpods-tray.ico" />

    <Feature Id="MainFeature" Title="AirPods Battery Tray" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="AirPodsBatteryTray">
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AirPods Battery Tray">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="TrayShortcut"
                    Name="AirPods Battery Tray"
                    Description="Show AirPods battery in the Windows notification area"
                    Target="[INSTALLFOLDER]AirPodsBattery.Tray.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="TrayIcon"
                    IconIndex="0" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\AirPodsBatteryTray"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RegistryValue Root="HKCU"
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="AirPodsBatteryTray"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]AirPodsBattery.Tray.exe&quot;" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
